# ===== Telegram (TON compte, via https://my.telegram.org > API development tools) =====
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
# @nom du canal ou ID numérique affiché par `python -m sniper.login`
TG_CHANNEL=-1001234567890

# ===== Claude (clé API sur https://console.anthropic.com) =====
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low

# ===== MT5 Deriv (optionnel si tu t'es déjà connecté dans l'interface web MT5) =====
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Deriv-Server
VNC_USER=trader
VNC_PASSWORD=change-moi

# ===== Mode =====
# trade   = exécution automatique sur ton compte
# dry_run = tout comme trade mais n'envoie PAS les ordres (affiche ce qu'il aurait fait)
# notify  = seulement les notifications (pas besoin de MT5)
MODE=trade

# ===== Taille des positions et risque =====
# Lot exécuté = lot de Festo x LOT_MULTIPLIER (arrondi au pas du symbole, plafonné à MAX_LOT)
LOT_MULTIPLIER=1.0
# Lot utilisé si Festo n'en donne pas (0 = lot minimum du symbole)
DEFAULT_LOT=0
MAX_LOT=5
MAX_OPEN_TRADES=5
# Pause automatique si la perte du jour dépasse ce montant (0 = désactivé)
MAX_DAILY_LOSS_USD=0
# SL posé quand le signal arrive sans SL (Festo l'envoie souvent 1 min après)
EMERGENCY_SL_USD=10
SL_WAIT_SECONDS=120
# final_be = TP broker sur le dernier TP + SL au prix d'entrée dès TP1 (recommandé)
# partial  = idem + coupe une part de la position à chaque TP
# final    = TP broker sur le dernier TP, rien d'autre
# first    = TP broker sur le premier TP
TP_MODE=final_be
# Glissement max accepté (en points) pour les ordres au marché
DEVIATION_POINTS=500
# Un signal plus vieux que ça (ex. après une coupure) n'est pas exécuté, juste notifié
MAX_SIGNAL_AGE_S=180
MIN_CONFIDENCE=0.7

# ===== Notifications =====
# Copie dans tes « Messages enregistrés » Telegram
NOTIFY_TELEGRAM_SAVED=true
# WhatsApp via CallMeBot (gratuit) : voir README
CALLMEBOT_PHONE=+243000000000
CALLMEBOT_APIKEY=
# Optionnel : POST {"text": "..."} vers une URL (ex. ton agent Hermès)
NOTIFY_WEBHOOK_URL=
